{
  "name": "orders_suite",
  "expectations": [
    { "type": "expect_column_values_to_not_be_null", "kwargs": { "column": "order_id" } },
    { "type": "expect_column_values_to_be_between", "kwargs": { "column": "amount", "min_value": 0, "max_value": 1000000 } },
    { "type": "expect_column_values_to_be_in_set", "kwargs": { "column": "currency", "value_set": ["INR", "USD", "EUR"] } },
    { "expectation_type": "expect_column_values_to_match_regex", "kwargs": { "column": "customer_id", "regex": "^c-[0-9]{3}$" } },
    { "type": "expect_table_row_count_to_be_between", "kwargs": { "min_value": 1 } }
  ]
}
